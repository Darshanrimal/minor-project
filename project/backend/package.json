{
  "name": "nepaldaan-backend",
  "version": "1.0.0",
  "description": "NepalDaan Charity Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/models/migrate.js",
    "seed": "node src/models/seed.js",
    "fresh": "node -e \"const fs=require('fs'); if(fs.existsSync('charity.db')) fs.unlinkSync('charity.db'); console.log('DB deleted');\" && node src/models/seed.js",
    "generate:treasury": "node scripts/generateTreasury.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.10.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
